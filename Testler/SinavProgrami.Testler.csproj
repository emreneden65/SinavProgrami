<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revizyon maddelerinin kontrol testleri. Her madde bittiğinde kendi testleri buraya
    eklenir; yeni bir madde eskilerden birini bozarsa burada yakalanır.
    Çalıştırma: Testler klasöründe terminal açıp  dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SinavProgrami.Testler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SinavProgrami.csproj" />
  </ItemGroup>

</Project>
