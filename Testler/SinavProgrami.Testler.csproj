<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revizyon maddelerinin kontrol testleri. Her madde bittiğinde kendi testleri buraya
    eklenir; yeni bir madde eskilerden birini bozarsa burada yakalanır.
    Çalıştırma: Testler klasöründe terminal açıp  dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SinavProgrami.Testler</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SinavProgrami.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yeni arayüzün Razor bileşenlerini pencere açmadan çizip denetlemek için -->
    <PackageReference Include="bunit" Version="2.11.3" />
  </ItemGroup>

  <!-- Ana projedeki gibi: WebView2 paketinin koşulsuz eklediği (kullanılmayan) WPF kütüphanesi
       WindowsBase sürüm çakışması uyarısı (MSB3277) vermesin. -->
  <Target Name="WebView2WpfBasvurusunuCikar" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
