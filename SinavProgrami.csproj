<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>SinavProgrami</AssemblyName>
    <RootNamespace>SinavProgrami</RootNamespace>

    <!-- Uygulama simgesi — exe'nin ve kısayolun ikonu -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- Windows'ta dosya özelliklerinde görünen bilgiler -->
    <Product>Sınav Programı</Product>
    <Company>Teknoloji Fakültesi</Company>
    <AssemblyTitle>Sınav Programı</AssemblyTitle>
    <Version>1.0.0</Version>

    <!-- Yayınlarken WinForms + EPPlus reflection kullandığı için trimming KAPALI kalmalı -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.7.0" />
    <!-- Taşınabilir veritabanı: sunucu gerektirmeyen, tek dosyalık SQLite.
         Bundle paketi native e_sqlite3 kütüphanesini de beraberinde getirir. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.27" />
  </ItemGroup>

  <ItemGroup>
    <!-- "Çekilmiş Dersler" doldurulurken temel alınan boş dağıtım şablonu.
         Çıktı klasörüne kopyalanır; CekilmisDerslerExportHelper bu dosyayı yükleyip doldurur.
         ÖNEMLİ: exe'nin yanındaki Templates\ klasöründe DURMAK ZORUNDADIR. -->
    <None Update="Templates\dagitim_sablonu.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

  </ItemGroup>

  <ItemGroup>
    <!-- Testler ayrı projedir (Testler\SinavProgrami.Testler.csproj) — programa derlenmez. -->
    <Compile Remove="Testler\**" />
    <EmbeddedResource Remove="Testler\**" />
    <None Remove="Testler\**" />
  </ItemGroup>

</Project>
